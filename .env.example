# ============================================================================
#  Credenciales de la agenda — copiá este archivo como .env.local y completalo.
#
#      cp .env.example .env.local
#
#  .env.local está en el .gitignore: nunca se sube al repo.
#  El paso a paso para conseguir estos valores está en SETUP-AGENDA.md
# ============================================================================

# Del cliente OAuth que creás en Google Cloud Console (paso 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Te lo devuelve:  npm run agenda:auth   (paso 4)
GOOGLE_REFRESH_TOKEN=

# Calendario donde se crean los turnos.
# 'primary' = el calendario principal de la cuenta que autorizaste.
# Si querés uno aparte, creá un calendario en Google Calendar y pegá acá su ID
# (Configuración del calendario → "ID del calendario").
GOOGLE_CALENDAR_ID=primary
